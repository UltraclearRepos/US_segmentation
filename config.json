{
  "paths": {
    "dataset_dir": "data/prepared/tg3k",
    "output_root": "outputs",
    "input_checkpoint": "input_checkpoints/best_model.pth"
  },
  "data": {
    "image_size": [
      256,
      256
    ],
    "augmentation": {
      "enabled": true,
      "flip_probability": 0.5,
      "rot90_probability": 0.5,
      "intensity_probability": 0.5,
      "noise_probability": 0.25
    }
  },
  "model": {
    "in_channels": 3,
    "bilinear": true
  },
  "training": {
    "seed": 42,
    "batch_size": 8,
    "num_workers": 2,
    "pin_memory": true,
    "epochs": 80,
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "loss": {
    "class_weight_power": 0.5,
    "cross_entropy_weight": 1.0,
    "lambda": 0.5,
    "smooth": 1e-6
  },
  "tensorboard": {
    "log_every_n_steps": 10
  },
  "callbacks": {
    "monitor": "val/mean_dice_fg",
    "early_stopping": {
      "enabled": true,
      "patience": 30,
      "min_delta": 0.0
    }
  }
}
